{
  "name": "lawquest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "demo": "node scripts/demo-content.cjs --expo",
    "demo:content": "node scripts/demo-content.cjs",
    "test:demo": "node --test scripts/demo-content.test.cjs",
    "parse:criminal-code": "node scripts/parse-criminal-code.cjs",
    "parse:civil-commercial-code": "node scripts/parse-civil-commercial-code.cjs",
    "parse:criminal-procedure-code": "node scripts/parse-criminal-procedure-code.cjs",
    "parse:civil-procedure-code": "node scripts/parse-civil-procedure-code.cjs",
    "parse:revenue-code": "node scripts/parse-revenue-code.cjs",
    "parse:land-code": "node scripts/parse-land-code.cjs",
    "parse:narcotics-code": "node scripts/parse-narcotics-code.cjs",
    "parse:military-criminal-code": "node scripts/parse-military-criminal-code.cjs",
    "export:legal-v2": "node scripts/export-legal-v2.cjs",
    "export:legal-structures": "node scripts/export-legal-structures.cjs",
    "update:english-sources": "node scripts/update-english-translation-sources.cjs",
    "index:english-source-pdf": "node scripts/index-english-source-pdf.cjs",
    "index:english-reference-docs": "node scripts/index-local-english-reference-docs.cjs",
    "validate:legal-translations": "node scripts/validate-legal-translations.cjs",
    "validate:legal-structure-translations": "node scripts/validate-legal-structure-translations.cjs",
    "normalize:legal-translation": "node scripts/normalize-legal-translation.cjs",
    "prepare:legal-v3": "node scripts/prepare-legal-v3-metadata.cjs",
    "build:legal-packages": "node scripts/build-legal-packages.cjs",
    "build:legal-packages:v3": "npm run prepare:legal-v3 && set LAWQUEST_LEGAL_DATASET=legal-v3&& node scripts/build-legal-packages.cjs",
    "release:legal-packages:dry-run": "node scripts/release-legal-packages.cjs --dry-run",
    "release:legal-packages": "node scripts/release-legal-packages.cjs",
    "release:legal-packages:v3:dry-run": "npm run prepare:legal-v3 && set LAWQUEST_LEGAL_DATASET=legal-v3&& node scripts/release-legal-packages.cjs --dry-run --skip-validate",
    "release:legal-packages:v3": "npm run prepare:legal-v3 && set LAWQUEST_LEGAL_DATASET=legal-v3&& node scripts/release-legal-packages.cjs --skip-validate",
    "test:services": "node scripts/test-service-migrations.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
