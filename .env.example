# Optional: required only for testing email sign-in with your own Supabase project.
# Use a public anon/publishable key. Never put service-role keys in an Expo app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional development content server. Leave blank for the hosted catalog.
EXPO_PUBLIC_LEGAL_MANIFEST_URL=
